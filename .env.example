# API Base URL:
# For local development with Vite reverse proxy:
# VITE_API_BASE_URL=/api
#
# For direct backend server connection in local development:
VITE_API_BASE_URL=https://pklf-backend.onrender.com/api

# For production deployment (point to your deployed backend API URL):
# VITE_API_BASE_URL=https://api.yourdomain.com/api
